---
layout: base.njk
---

{% set videos = collections.videos %}
{% set destacadoVideo = videos[0] %}
{% set restoVideos = videos.slice(1) %}
{% set platformThumbs = platformThumbnails | default({}) %}
<section class="section reveal from-up" id="videos">
  <div class="section-head"><h2 class="section-title" data-text="VIDEOS & RECIENTES">VIDEOS & RECIENTES</h2></div>
  {% if destacadoVideo %}
  <div class="feature-grid">
    <div class="feature-media">
      {% if destacadoVideo.data.youtube %}<div class="video-embed-wrap"><iframe src="{{ destacadoVideo.data.youtube | youtubeEmbed }}" title="{{ destacadoVideo.data.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
      {% elif destacadoVideo.data.bitchute %}<div class="video-embed-wrap"><iframe src="{{ destacadoVideo.data.bitchute | bitchuteEmbed }}" title="{{ destacadoVideo.data.title }}" loading="lazy" allowfullscreen></iframe></div>
      {% elif destacadoVideo.data.odysee %}<div class="video-embed-wrap"><iframe src="{{ destacadoVideo.data.odysee | odyseeEmbed }}" title="{{ destacadoVideo.data.title }}" loading="lazy" allowfullscreen></iframe></div>
      {% else %}<a class="media-placeholder" href="{{ destacadoVideo.url }}"><img src="{% if destacadoVideo.data.thumbnail %}{{ destacadoVideo.data.thumbnail }}{% elif destacadoVideo.data.youtube %}{{ destacadoVideo.data.youtube | youtubeThumbnail }}{% elif destacadoVideo.data.bitchute %}{{ platformThumbs[destacadoVideo.data.bitchute] | default('/assets/thumbs/bitchute.svg') }}{% elif destacadoVideo.data.odysee %}{{ platformThumbs[destacadoVideo.data.odysee] | default('/assets/thumbs/odysee.svg') }}{% else %}/assets/thumbs/video.svg{% endif %}" alt="{{ destacadoVideo.data.title }}"><span class="media-overlay-title">{{ destacadoVideo.data.title }}</span><span class="ctr-play-btn"></span></a>{% endif %}
    </div>
    <div class="feature-copy"><div class="meta">VIDEO MAS RECIENTE · {{ destacadoVideo.data.date }}</div><h3>{{ destacadoVideo.data.title }}</h3><p>{{ destacadoVideo.data.description | default('Archivo audiovisual de SoFirMoLo.') }}</p><a href="{{ destacadoVideo.url }}" class="ctr-link">VER VIDEO COMPLETO →</a></div>
  </div>
  {% endif %}
  <div class="carousel-wrap"><div class="carousel-track" id="videos-track">
    {% for item in restoVideos %}{% if item.data.thumbnail %}{% set thumb = item.data.thumbnail %}{% elif item.data.youtube %}{% set thumb = item.data.youtube | youtubeThumbnail %}{% elif item.data.bitchute %}{% set thumb = platformThumbs[item.data.bitchute] | default('/assets/thumbs/bitchute.svg') %}{% elif item.data.odysee %}{% set thumb = platformThumbs[item.data.odysee] | default('/assets/thumbs/odysee.svg') %}{% else %}{% set thumb = '/assets/thumbs/video.svg' %}{% endif %}
    <a class="card" href="{{ item.url }}"><div class="card-cover"><img src="{{ thumb }}" alt="Miniatura: {{ item.data.title }}" loading="lazy"{% if item.data.odysee %} data-platform-thumb="{{ item.data.odysee }}"{% elif item.data.bitchute %} data-platform-thumb="{{ item.data.bitchute }}"{% endif %}><span class="thumb-shade"></span><span class="ctr-play-btn ctr-play-btn-sm"></span></div><div class="meta">ARCHIVO AUDIOVISUAL · {{ item.data.date }}</div><h4>{{ item.data.title }}</h4><p>{{ item.data.description | default('Ver publicación completa.') }}</p></a>
    {% endfor %}
  </div></div>
</section>

{% set directos = collections.directos %}
{% set destacadoDirecto = directos[0] %}
{% set restoDirectos = directos.slice(1) %}
<section class="section reveal from-right" id="livestreams">
  <div class="section-head"><h2 class="section-title" data-text="TRANSMISIONES EN VIVO">TRANSMISIONES EN VIVO</h2></div>
  {% if destacadoDirecto %}
  <div class="feature-grid">
    <div class="feature-media">
      {% if destacadoDirecto.data.youtube %}<div class="video-embed-wrap"><iframe src="{{ destacadoDirecto.data.youtube | youtubeEmbed }}" title="{{ destacadoDirecto.data.title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
      {% elif destacadoDirecto.data.bitchute %}<div class="video-embed-wrap"><iframe src="{{ destacadoDirecto.data.bitchute | bitchuteEmbed }}" title="{{ destacadoDirecto.data.title }}" loading="lazy" allowfullscreen></iframe></div>
      {% elif destacadoDirecto.data.odysee %}<div class="video-embed-wrap"><iframe src="{{ destacadoDirecto.data.odysee | odyseeEmbed }}" title="{{ destacadoDirecto.data.title }}" loading="lazy" allowfullscreen></iframe></div>
      {% else %}{% if destacadoDirecto.data.thumbnail %}{% set thumb = destacadoDirecto.data.thumbnail %}{% elif destacadoDirecto.data.youtube %}{% set thumb = destacadoDirecto.data.youtube | youtubeThumbnail %}{% elif destacadoDirecto.data.bitchute %}{% set thumb = destacadoDirecto.data.bitchute | platformThumbnail('directo') %}{% elif destacadoDirecto.data.odysee %}{% set thumb = destacadoDirecto.data.odysee | platformThumbnail('directo') %}{% else %}{% set thumb = '/assets/thumbs/directo.svg' %}{% endif %}<a class="media-placeholder" href="{{ destacadoDirecto.url }}"><img src="{{ thumb }}" alt="{{ destacadoDirecto.data.title }}"{% if destacadoDirecto.data.odysee %} data-platform-thumb="{{ destacadoDirecto.data.odysee }}"{% elif destacadoDirecto.data.bitchute %} data-platform-thumb="{{ destacadoDirecto.data.bitchute }}"{% endif %}><span class="media-overlay-title">{{ destacadoDirecto.data.title }}</span><span class="ctr-play-btn"></span></a>{% endif %}
    </div>
    <div class="feature-copy"><div class="meta">TRANSMISION RECIENTE · {{ destacadoDirecto.data.date }}</div><h3>{{ destacadoDirecto.data.title }}</h3><p>{{ destacadoDirecto.data.description | default('Grabación integral de una transmisión de SoFirMoLo.') }}</p><a href="{{ destacadoDirecto.url }}" class="ctr-link">ACCEDER AL DIRECTO →</a></div>
  </div>
  {% endif %}
  <div class="carousel-wrap"><div class="carousel-track" id="live-track">
    {% for item in restoDirectos %}{% if item.data.thumbnail %}{% set thumb = item.data.thumbnail %}{% elif item.data.youtube %}{% set thumb = item.data.youtube | youtubeThumbnail %}{% elif item.data.bitchute %}{% set thumb = platformThumbs[item.data.bitchute] | default('/assets/thumbs/bitchute.svg') %}{% elif item.data.odysee %}{% set thumb = platformThumbs[item.data.odysee] | default('/assets/thumbs/odysee.svg') %}{% else %}{% set thumb = '/assets/thumbs/directo.svg' %}{% endif %}
    <a class="card" href="{{ item.url }}"><div class="card-cover"><img src="{{ thumb }}" alt="Miniatura: {{ item.data.title }}" loading="lazy"{% if item.data.odysee %} data-platform-thumb="{{ item.data.odysee }}"{% elif item.data.bitchute %} data-platform-thumb="{{ item.data.bitchute }}"{% endif %}><span class="thumb-shade"></span><span class="ctr-play-btn ctr-play-btn-sm"></span></div><div class="meta">HISTORIAL DE LIVES · {{ item.data.date }}</div><h4>{{ item.data.title }}</h4><p>{{ item.data.description | default('Ver transmisión completa.') }}</p></a>
    {% endfor %}
  </div></div>
</section>

{% set articulos = collections.articulos %}
{% set destacadoArt = articulos[0] %}
{% set restoArt = articulos.slice(1) %}
<section class="section reveal from-left" id="articles">
  <div class="section-head"><h2 class="section-title" data-text="ARTICULOS & ENSAYOS">ARTICULOS & ENSAYOS</h2></div>
  {% if destacadoArt %}{% set thumb = destacadoArt.data.thumbnail or '/assets/thumbs/article.svg' %}
  <div class="article-layout"><a class="article-cover" href="{{ destacadoArt.url }}"><img src="{{ thumb }}" alt="Miniatura: {{ destacadoArt.data.title }}"><span class="thumb-shade"></span><span class="article-cover-label">ARTÍCULO DESTACADO</span></a><div class="article-body"><div class="meta">PUBLICACION ESCRITA · {{ destacadoArt.data.date }}{% if destacadoArt.data.author %} · {{ destacadoArt.data.author }}{% endif %}</div><h3>{{ destacadoArt.data.title }}</h3><p>{{ destacadoArt.data.description | default('Ensayo y publicación escrita de SoFirMoLo.') }}</p><a href="{{ destacadoArt.url }}" class="ctr-link">LEER ARTICULO →</a></div></div>
  {% endif %}
  <div class="carousel-wrap"><div class="carousel-track" id="articles-track">
    {% for item in restoArt %}{% set thumb = item.data.thumbnail or '/assets/thumbs/article.svg' %}<a class="card article-card" href="{{ item.url }}"><div class="card-cover"><img src="{{ thumb }}" alt="Miniatura: {{ item.data.title }}" loading="lazy"{% if item.data.odysee %} data-platform-thumb="{{ item.data.odysee }}"{% elif item.data.bitchute %} data-platform-thumb="{{ item.data.bitchute }}"{% endif %}><span class="thumb-shade"></span><span class="article-cover-label">ARTÍCULO</span></div><div class="meta">PUBLICACION ESCRITA · {{ item.data.date }}</div><h4>{{ item.data.title }}</h4><p>{{ item.data.description | default('Leer publicación completa.') }}</p></a>{% endfor %}
  </div></div>
</section>

{% set recursos = collections.recursos %}
{% set destacadoRec = recursos[0] %}
{% set restoRec = recursos.slice(1) %}
<section class="section reveal from-right" id="resources">
  <div class="section-head"><h2 class="section-title" data-text="RECURSOS & ARCHIVO">RECURSOS & ARCHIVO</h2></div>
  {% if destacadoRec %}{% set thumb = destacadoRec.data.thumbnail or '/assets/thumbs/recurso.svg' %}
  <div class="resource-card"><a class="resource-preview" href="{{ destacadoRec.url }}"><img src="{{ thumb }}" alt="Miniatura: {{ destacadoRec.data.title }}"><span class="thumb-shade"></span><span class="article-cover-label">RECURSO DESTACADO</span></a><div class="resource-body"><div class="meta">BIBLIOTECA ABIERTA · {{ destacadoRec.data.date }}</div><h3>{{ destacadoRec.data.title }}</h3><p>{{ destacadoRec.data.description | default('Documento y material de consulta.') }}</p><a href="{{ destacadoRec.url }}" class="ctr-link">VER RECURSO →</a></div></div>
  {% endif %}
  <div class="carousel-wrap"><div class="carousel-track resource-track" id="resources-track">
    {% for item in restoRec %}{% set thumb = item.data.thumbnail or '/assets/thumbs/recurso.svg' %}<a class="card" href="{{ item.url }}"><div class="card-cover"><img src="{{ thumb }}" alt="Miniatura: {{ item.data.title }}" loading="lazy"{% if item.data.odysee %} data-platform-thumb="{{ item.data.odysee }}"{% elif item.data.bitchute %} data-platform-thumb="{{ item.data.bitchute }}"{% endif %}><span class="thumb-shade"></span><span class="article-cover-label">{{ item.data.categoria | default('ARCHIVO') }}</span></div><div class="meta">RECURSO · {{ item.data.date }}</div><h4>{{ item.data.title }}</h4><p>{{ item.data.description | default('Abrir recurso.') }}</p></a>{% endfor %}
  </div></div>
</section>
