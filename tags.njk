---
pagination:
  data: collections.tagList
  size: 1
  alias: tag
permalink: "/tags/{{ tag | slug }}/"
layout: base.njk
eleventyComputed:
  title: "Tag: {{ tag }}"
  description: "Todo el contenido de SoFirMoLo relacionado con {{ tag }}."
---
          <section class="section reveal from-up" id="tag-detail">
            <div class="section-head">
              <h2 class="section-title" data-text="TAG: {{ tag | upper }}">TAG: {{ tag | upper }}</h2>
            </div>

            <div class="carousel-wrap">
              <div class="carousel-track" style="flex-wrap: wrap; overflow: visible;">
                {% for item in collections.all %}
                {% if item.data.tags and tag in item.data.tags %}
                {% set thumb = item.data | resolveThumb %}
                <a class="card" href="{{ item.url }}">
                  <div class="card-cover"><img src="{{ thumb }}" alt="Miniatura: {{ item.data.title }}" loading="lazy"><span class="thumb-shade"></span><span class="ctr-play-btn ctr-play-btn-sm"></span></div>
                  <div class="meta">{% if item.date %}{{ item.date | fechaCorta }}{% endif %}</div>
                  <h4>{{ item.data.title }}</h4>
                  <p>{{ item.data.description }}</p>
                </a>
                {% endif %}
                {% endfor %}
              </div>
            </div>

            <p style="margin-top:24px;"><a href="/" class="ctr-link">← VOLVER AL INICIO</a></p>
          </section>
