---
layout: base.njk
modo_lectura: true
---
<section class="section reveal from-right" id="recurso-detail">
  <div class="section-head"><h2 class="section-title" data-text="{{ title }}">{{ title }}</h2></div>
  {% set thumb = thumbnail or '/assets/thumbs/recurso.svg' %}
  <div class="resource-card"><a class="resource-preview" href="{{ thumb }}" target="_blank" rel="noopener"><img src="{{ thumb }}" alt="{{ title }}"><span class="thumb-shade"></span><span class="article-cover-label">{{ categoria | default('RECURSO') }}</span></a><div class="resource-body"><div class="meta">BIBLIOTECA ABIERTA{% if date %} · {{ date | fechaCorta }}{% endif %}{% if categoria %} · {{ categoria }}{% endif %}</div><h3>{{ title }}</h3><p>{{ description | default('Material de consulta.') }}</p>{% if archivo %}<p><a href="{{ archivo }}" class="ctr-link" target="_blank" rel="noopener">DESCARGAR RECURSO →</a></p>{% endif %}{% if enlace %}<p><a href="{{ enlace }}" class="ctr-link" target="_blank" rel="noopener">LEER ONLINE →</a></p>{% endif %}</div></div>
  {{ content | safe }}
  {% if tags %}
  <p style="margin-top:16px;">
    {% for t in tags %}{% if t not in ["videos","directos","articulos","recursos"] %}<a href="/tags/{{ t | slug }}/" class="ctr-link" style="margin-right:12px;">#{{ t }}</a>{% endif %}{% endfor %}
  </p>
  {% endif %}
  <p style="margin-top:24px;"><a href="/" class="ctr-link">← VOLVER AL INICIO</a></p>
</section>
