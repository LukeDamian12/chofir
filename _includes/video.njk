---
layout: base.njk
---
          <section class="section reveal from-up" id="video-detail">
            <div class="section-head">
              <h2 class="section-title" data-text="{{ title }}">{{ title }}</h2>
            </div>

            <div class="feature-grid">
              <div class="feature-media">
                {% if youtube %}
                <div class="video-embed-wrap">
                  <iframe src="{{ youtube | youtubeEmbed }}" title="{{ title }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
                {% elif bitchute %}
                <div class="video-embed-wrap">
                  <iframe src="{{ bitchute | bitchuteEmbed }}" title="{{ title }}" loading="lazy" allowfullscreen></iframe>
                </div>
                {% elif odysee %}
                <div class="video-embed-wrap">
                  <iframe src="{{ odysee | odyseeEmbed }}" title="{{ title }}" loading="lazy" allowfullscreen></iframe>
                </div>
                {% else %}
                <div class="ctr-play-btn"></div>
                <div class="media-placeholder">{{ title }}<br><small>REPRODUCTOR AUDIOVISUAL</small></div>
                {% endif %}
              </div>
              <div class="feature-copy">
                <div class="meta">ARCHIVO AUDIOVISUAL{% if date %} · {{ date }}{% endif %}</div>
                <h3>{{ title }}</h3>
                <p>{{ description }}</p>
                {% if youtube %}<p><a href="{{ youtube }}" class="ctr-link" target="_blank" rel="noopener">ABRIR EN YOUTUBE →</a></p>{% endif %}
                {% if bitchute %}<p><a href="{{ bitchute }}" class="ctr-link" target="_blank" rel="noopener">ABRIR EN BITCHUTE →</a></p>{% endif %}
                {% if odysee %}<p><a href="{{ odysee }}" class="ctr-link" target="_blank" rel="noopener">ABRIR EN ODYSEE →</a></p>{% endif %}
                {% if download %}<p><a href="{{ download }}" class="ctr-link" target="_blank" rel="noopener">DESCARGAR →</a></p>{% endif %}
              </div>
            </div>

            {{ content | safe }}

            <p style="margin-top:24px;"><a href="/" class="ctr-link">← VOLVER AL INICIO</a></p>
          </section>
